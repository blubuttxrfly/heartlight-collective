# Upstash Redis (server-side only — also set in Vercel project settings)
# Get these from https://console.upstash.com or via Vercel Storage integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ────────────────────────────────────────────────────────────
# Legacy Supabase (used ONLY by the migration script in Wave 8)
# Removed after migration is complete (Wave 9)
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=